#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  MrHunter pre-push guard
#
#  Scans the files you are about to push for exposed secrets and high-risk
#  code patterns, prints what it found, and asks for your consent BEFORE the
#  push is allowed. Say "no" (or press Enter) and the push is blocked.
#
#  Enable once per clone:
#      git config core.hooksPath .githooks
#
#  Bypass in an emergency (you are on your own):
#      git push --no-verify
#
#  Note: this is a fast, dependency-free, grep-based guard. It is NOT the full
#  MrHunter assessment (that runs inside your AI agent and needs an LLM).
# ─────────────────────────────────────────────────────────────────────────────

set -u

z40="0000000000000000000000000000000000000000"
RED=$'\033[31m'; YEL=$'\033[33m'; GRN=$'\033[32m'; DIM=$'\033[2m'; RST=$'\033[0m'

# ── 1. collect the files changed in the commits being pushed ────────────────
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue            # branch deletion — nothing to scan
  if [ "$remote_sha" = "$z40" ]; then              # brand-new branch
    if git rev-parse --verify -q "${local_sha}^" >/dev/null 2>&1; then
      changed="$changed"$'\n'"$(git diff --name-only "${local_sha}^" "$local_sha" 2>/dev/null)"
    else
      changed="$changed"$'\n'"$(git ls-tree -r --name-only "$local_sha" 2>/dev/null)"
    fi
  else
    changed="$changed"$'\n'"$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)"
  fi
done
changed="$(printf '%s\n' "$changed" | sed '/^[[:space:]]*$/d' | sort -u)"

# ── 2. scan only source-ish files (skip fixtures, assets, docs, deps) ───────
scan="$(printf '%s\n' "$changed" \
  | grep -vE '(^|/)(test-cases|tests|__tests__|fixtures|samples|examples|node_modules|vendor|dist|build|assets)/' \
  | grep -E '\.(py|js|jsx|ts|tsx|java|go|php|rb|kt|swift|c|cc|cpp|h|hpp|sh|bash|zsh|ps1|yml|yaml|json|env|ini|cfg|conf|properties|tf|xml)$' \
  || true)"

if [ -z "$scan" ]; then
  echo "${GRN}MrHunter pre-push guard: no source files to scan.${RST}"
  exit 0
fi

# ── 3. patterns ─────────────────────────────────────────────────────────────
SECRETS='AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|glpat-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{48}|sk-(proj|svcacct|admin)-|sk-ant-api03|pplx-[A-Za-z0-9]{48}|xox[bpas]-|rzp_live_|sk_live_|-----BEGIN [A-Z ]*PRIVATE KEY-----'
RISKY='os\.system\(|os\.popen\(|shell[[:space:]]*=[[:space:]]*True|(^|[^A-Za-z0-9_.])eval\(|(^|[^A-Za-z0-9_.])exec\(|pickle\.load|yaml\.load\(|innerHTML|dangerouslySetInnerHTML|document\.write\(|verify[[:space:]]*=[[:space:]]*False|algorithms[[:space:]]*:[[:space:]]*\[[^]]*none|Access-Control-Allow-Origin["'"'"']?[[:space:]]*[:=]?[[:space:]]*["'"'"']\*'

findings=""; hits=0
for f in $scan; do
  [ -f "$f" ] || continue
  s="$(grep -nEI "$SECRETS" "$f" 2>/dev/null || true)"
  if [ -n "$s" ]; then hits=$((hits+1)); findings="$findings"$'\n'"${RED}[SECRET]${RST} $f"$'\n'"$s"; fi
  r="$(grep -nEI "$RISKY" "$f" 2>/dev/null || true)"
  if [ -n "$r" ]; then hits=$((hits+1)); findings="$findings"$'\n'"${YEL}[RISKY ]${RST} $f"$'\n'"$r"; fi
done

if [ "$hits" -eq 0 ]; then
  echo "${GRN}MrHunter pre-push guard: clean.${RST}"
  exit 0
fi

# ── 4. show findings and ask for consent ────────────────────────────────────
echo ""
echo "${RED}MrHunter pre-push guard found potential issues:${RST}"
printf '%b\n' "$findings"
echo ""
echo "${DIM}Advisory only — review each item. Nothing has been pushed yet.${RST}"
echo ""

ans=""
if { exec 3</dev/tty; } 2>/dev/null; then
  printf "Push anyway? [y/N] " >&3
  read -r ans <&3 || ans=""
  exec 3<&-
fi

case "$ans" in
  y|Y|yes|YES)
    echo "${YEL}Proceeding with push.${RST}"
    exit 0
    ;;
  *)
    echo "${RED}Push blocked. Fix the findings, or bypass with: git push --no-verify${RST}"
    exit 1
    ;;
esac
